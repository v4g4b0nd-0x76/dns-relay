[Unit]
Description=DNS Relay GUI managed resolver
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/opt/dns-relay-gui/dns_relay --conf /opt/dns-relay-gui/conf.toml run
WorkingDirectory=/var/log/dns-relay-gui
LogsDirectory=dns-relay-gui
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/dns-relay-gui
ReadWritePaths=/var/log/dns-relay-gui
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
