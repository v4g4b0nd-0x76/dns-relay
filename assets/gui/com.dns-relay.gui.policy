<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DNS Relay</vendor>
  <action id="com.dns-relay.gui.admin">
    <description>Manage the DNS Relay service</description>
    <message>Authentication is required to manage DNS Relay</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/dns-relay-gui/dns_relay_admin</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">request</annotate>
  </action>
</policyconfig>
